# Copy to .env at the repo root. Every knob here is OPTIONAL except
# DATABASE_URL, and each block says what happens when it is absent.
# This file is the one that ships: never put a real key in it.

# ------------------------------------------------------------------ database
# TWO DSNs, deliberately. server.ts opens the owner pool, runs the migrations,
# asserts the immutability guards are intact, closes it, and only then opens the
# app pool and takes the port.
#
# coinpicks_owner owns every table. A session that owns them can DROP TRIGGER in
# one statement, and a superuser can SET session_replication_role = replica and
# edit a committed report with every trigger installed and silent. Neither is
# something a request should be able to reach, so the owner DSN lives for about
# fifty milliseconds per boot.
#
# Absent: the API refuses to start. That is deliberate — a ledger with no
# database is not a degraded mode worth having.
#
# Create the roles once (and rebuild coinpicks_test) with:
#   docker compose up -d db
#   pnpm --filter @coinpicks/api run db:bootstrap
DATABASE_URL_OWNER=postgresql://coinpicks_owner:coinpicks_owner@localhost:5433/coinpicks
DATABASE_URL=postgresql://coinpicks_app:coinpicks_app@localhost:5433/coinpicks

# The same database seen through the GRANT-limited `research` role: SELECT on
# coins/reports/report_scores/report_team/citations, SELECT+INSERT on
# forward_returns, and UPDATE on its five outcome columns only — report_id and
# horizon_days are the ledger's join key and are immutable by privilege, and
# return_fraction is a generated column no grant can make writable.
# research/forward_returns.py does NOT exist yet — it is build-order step 6.
RESEARCH_DATABASE_URL=postgresql://research:research@localhost:5433/coinpicks

# Where the api listens. Loopback only, one user, no auth.
PORT=8789
```

# ------------------------------------------------------------- research data
# The point-in-time parquet warehouse research/config.py resolves, and that the
# forward-return join (build-order step 6) will read. Horizons are frozen at 30/90/180/365
# days.
# Absent: defaults to research/warehouse/ beside the code, which is where the
# backfill writes and is gitignored. Set it only on a machine that keeps the
# warehouse somewhere else.
RESEARCH_WAREHOUSE_DIR=

# ----------------------------------------------------------- model providers
# The EvidenceFinder (apps/api/src/evidence/providers.ts) proposes candidate
# {url, quote, why} citations for a claim and nothing else. It never proposes a
# number — the human types every score — and every candidate goes through the
# deterministic citation verifier before it is displayed.
#
# Absent (no key set at all): the finder is inert. The flow still runs,
# candidates come from recorded fixtures, and the envelope is stamped
# origin:"fixture" so a keyless run can never be mistaken for a model candidate.
#
# One funded DashScope international key serves all four providers below over a
# single OpenAI-compatible endpoint, so the same value goes in each *_API_KEY
# you intend to use:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# BASE_URL and MODEL are per-provider overrides; unset means the default
# compiled into evidence/providers.ts.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=

# Which provider the finder uses. Two names, one setting:
#   DEFAULT_PROVIDER          — the in-code constant in evidence/providers.ts,
#                               DELIBERATELY UNPINNED until the bench runs.
#   COINPICKS_MODEL_PROVIDER  — this variable, the environment override that
#                               wins over DEFAULT_PROVIDER when it is set.
# The default is decided by running one real coin section through kimi-k3,
# deepseek-v4.1-flash and qwen3.8-max and recording the result — never pinned on
# price or on vibes. With neither set, the finder stays inert rather than
# guessing a default.
COINPICKS_MODEL_PROVIDER=
